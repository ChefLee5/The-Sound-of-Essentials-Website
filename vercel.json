{
  "installCommand": "cd web && npm install",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "redirects": [
    { "source": "/universe", "destination": "/heroes", "permanent": true },
    { "source": "/characters", "destination": "/heroes", "permanent": true },
    { "source": "/media", "destination": "/listen", "permanent": true },
    { "source": "/quieter-way", "destination": "/story", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://soe-website-b7j.pages.dev/api/:path*" },
    { "source": "/story", "destination": "/story.html" },
    { "source": "/dad-reading-apps-review", "destination": "/dad-reading-apps-review.html" },
    { "source": "/education-sovereignty", "destination": "/education-sovereignty.html" },
    { "source": "/global-learn-english", "destination": "/global-learn-english.html" },
    { "source": "/sing-along-time", "destination": "/sing-along-time.html" },
    { "source": "/alternatives/abcmouse", "destination": "/abcmouse-alternatives.html" },
    { "source": "/abcmouse-alternatives", "destination": "/abcmouse-alternatives.html" },
    { "source": "/alternatives/reading-eggs", "destination": "/reading-eggs-alternatives.html" },
    { "source": "/reading-eggs-alternatives", "destination": "/reading-eggs-alternatives.html" },
    { "source": "/alternatives/hooked-on-phonics", "destination": "/hooked-on-phonics-alternatives.html" },
    { "source": "/hooked-on-phonics-alternatives", "destination": "/hooked-on-phonics-alternatives.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
