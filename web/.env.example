# SOE Environment Configuration

# Optional: Set this to your Cloudflare R2 bucket custom domain (zero-egress CDN)
# Example: https://media.soundofessentials.com or https://pub-xxxx.r2.dev
VITE_ASSET_HOST=

# Optional: Neon Database URL & Auth (if interacting with serverless backend)
VITE_NEON_AUTH_URL=

# Square Checkout & Webhooks (Serverless Cloudflare Pages Functions)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=production
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://soelearn.com/api/webhooks/square
SQUARE_RHYTHM_PASS_PLAN_ID=

# Optional Static Square Payment Link Overrides (if not using /api/checkout/square)
VITE_SQUARE_STARTER_PACK_URL=
VITE_SQUARE_STORYBOOK_URL=
VITE_SQUARE_WORKBOOK_DIGITAL_URL=
VITE_SQUARE_WORKBOOK_PRINT_URL=
VITE_SQUARE_COMPLETE_PACK_URL=
VITE_SQUARE_RHYTHM_PASS_URL=
VITE_SQUARE_DICTIONARY_URL=
VITE_SQUARE_HEADPHONES_URL=
VITE_SQUARE_BUNDLE_URL=
VITE_SQUARE_DONATION_URL=

# Web3 Agentic Protocols (x402 Base USDC Settlement & ERC-8004 Identity)
SOE_TREASURY_WALLET_ADDRESS=
SOE_X402_NETWORK=base
SOE_X402_FACILITATOR_URL=
SOE_ERC8004_CONTRACT_ADDRESS=
SOE_ERC8004_AGENT_ID=

# Consent-Gated Multi-Channel Conversion Telemetry (COPPA-safe: loaded ONLY after consent)
VITE_GOOGLE_ADS_ID=
VITE_PINTEREST_TAG_ID=
VITE_X_PIXEL_ID=
VITE_REDDIT_PIXEL_ID=
